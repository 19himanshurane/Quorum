# Provider mode: "mock" needs no API keys and runs deterministic stand-in critics
# (useful for demos/CI). "live" calls real Groq / Mistral (or OpenAI / NVIDIA /
# Ollama, if you point a critic at them instead) models.
ARBITRATION_PROVIDER_MODE=mock

# --- Live mode: one API key per provider in use ---
# Copy this file to .env (already gitignored) and put your real keys there -
# never in this tracked template.
GROQ_API_KEY=
MISTRAL_API_KEY=
# Only needed if you point a critic's *_PROVIDER back at nvidia - see note below.
NVIDIA_API_KEY=

# Accuracy critic - Groq
ACCURACY_CRITIC_PROVIDER=groq
ACCURACY_CRITIC_MODEL=openai/gpt-oss-120b

# Logic critic - Mistral (Mistral Large)
LOGIC_CRITIC_PROVIDER=mistral
LOGIC_CRITIC_MODEL=mistral-large-latest

# Completeness critic - Groq, different model family than the accuracy critic
# (Qwen vs OpenAI's gpt-oss) so the two don't share blind spots. NVIDIA NIM was
# the original pick here but its free tier was too slow/queued in practice
# (observed 51s-180s+ per call); swap COMPLETENESS_CRITIC_PROVIDER=nvidia back
# if you have a paid/faster NIM tier.
COMPLETENESS_CRITIC_PROVIDER=groq
COMPLETENESS_CRITIC_MODEL=qwen/qwen3.6-27b

# Adjudicator (weighs all three critics' evidence into the final verdict)
ADJUDICATOR_PROVIDER=mistral
ADJUDICATOR_MODEL=mistral-large-latest

# Optional: point any critic at a self-hosted Ollama instance instead by
# setting its *_PROVIDER=ollama and *_MODEL to a locally pulled model name.
OLLAMA_BASE_URL=http://localhost:11434/v1

# Storage
ARBITRATION_DB_PATH=data/arbitration.db

# Retry behavior for critic calls
CRITIC_MAX_RETRIES=2
CRITIC_REQUEST_TIMEOUT_SECONDS=30
